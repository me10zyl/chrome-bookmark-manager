{
  "manifest_version": 3,
  "name": "书签管理器",
  "version": "1.0",
  "description": "一个简单的书签管理器",
  "permissions": [
    "bookmarks",
    "tabs",
    "history",
    "favicon",
    "tabGroups",
    "sidePanel",
    "contextMenus",
    "scripting",
    "commands"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+U",
        "mac": "Command+U"
      },
      "description": "打开全局搜索"
    },
    "open-bookmark-group": {
      "suggested_key": {
        "default": "Alt+I",
        "mac": "Command+U"
      },
      "description": "打开书签组"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
} 